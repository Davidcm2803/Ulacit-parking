@model  List<Ulacit_parking.Models.ViewModels.VehicleViewModel>

@{
    ViewBag.Title = "Mis Vehículos";
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="navbar-links d-flex align-items-right" style="position:relative; right:-1700px">
        @{
            var usuario = Session["AdminLogged"] as Ulacit_parking.Models.User
                       ?? Session["UserLogged"] as Ulacit_parking.Models.User;
        }

        @if (usuario != null)
        {
            <div class="dropdown me-3">
                <button class="btn btn-outline-black dropdown-toggle d-flex align-items-center" type="button" id="userDropdown" data-bs-toggle="dropdown">
                    <span class="me-2">@usuario.Name</span>
                    <i class="fas fa-user-circle"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i>Perfil</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("CambiarPassword", "Admin")"><i class="fas fa-lock me-2"></i>Cambiar contraseña</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Admin")"><i class="fas fa-sign-out-alt me-2"></i>Cerrar sesión</a></li>
                </ul>
            </div>
        }
        else
        {
            <a href="@Url.Action("Login", "Admin")" class="btn btn-sm btn-outline-light">Iniciar sesión</a>
        }
    </div>
</nav>

<div class="container py-6">
    <h2 class="text-center mb-4 text-primary">Mis Vehículos</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center">
            No tienes vehículos registrados.
        </div>
    }
    else
    {
        <div class="table-responsive shadow rounded">
            <table class="table table-hover align-middle table-bordered mb-0">
                <thead class="table-dark text-center">
                    <tr>
                        <th scope="col">Marca</th>
                        <th scope="col">Color</th>
                        <th scope="col">Placa</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">¿Espacio especial?</th>
                        <th scope="col">Historial</th>
                    </tr>
                </thead>
                <tbody class="text-center">
                    @foreach (var vehiculo in Model)
                    {
                        <tr>
                            <td>@vehiculo.Brand</td>
                            <td>@vehiculo.Color</td>
                            <td>@vehiculo.LicensePlate</td>
                            <td>@vehiculo.VehicleType</td>
                            <td>
                                @if (vehiculo.UsesSpecialSpace)
                                {
                                    <span class="badge bg-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("Historial", "Usuario", new { id = vehiculo.Id })"
                                   class="btn btn-sm btn-primary">
                                    Ver
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>