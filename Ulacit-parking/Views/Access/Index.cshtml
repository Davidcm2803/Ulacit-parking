@model List<Ulacit_parking.Models.ParkingLot>
@{
    var user = Session["AdminLogged"] as Ulacit_parking.Models.User
            ?? Session["UserLogged"] as Ulacit_parking.Models.User;

    var isGuard = user != null && user.RoleId == 2;
}

@{
    ViewBag.Title = "Acceso";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow rounded-4">
                <div class="card-body">
                    <h2 class="mb-4 text-start">Entrada/Salida</h2>

                    <!-- Dropdown para seleccionar el parqueo -->
                    <div class="mb-3">
                        <label class="form-label">Seleccionar parqueo:</label>
                        <select id="parkingLotSelect" class="form-select">
                            @foreach (var p in Model)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Input de placa -->
                    <div class="mb-3">
                        <label for="placa" class="form-label">Placa del vehículo:</label>
                        <input type="text" id="placa" class="form-control" placeholder="Ingrese la placa">
                    </div>

                    <!-- Botones de acción: ingreso y salida -->
                    <div class="d-flex justify-content-between mb-4">
                        <button onclick="registrarIngreso()" class="btn btn-success w-45">Registrar Ingreso</button>
                        <button onclick="registrarSalida()" class="btn btn-warning w-45">Registrar Salida</button>
                    </div>

                    <!-- Contenedor de mensajes -->
                    <div class="alert text-center fw-bold" id="mensaje" style="display: none;"></div>

                    <!-- Semáforo visual de ingreso -->
                    <div class="text-center my-4">
                        <h4 class="mb-3">Semáforo de Ingreso</h4>
                        <div id="semaforo" style="width: 100px; height: 100px; margin: auto; border-radius: 50%; background-color: gray;"></div>
                        <p id="mensajeSemaforo" class="fw-bold mt-3"></p>
                    </div>

                    <hr />

                    <!-- Estado actual del parqueo -->
                    <div class="text-center">
                        <h4>Estado actual del parqueo</h4>
                        <p id="estadoRegular" class="mb-1">Vehículos: </p>
                        <p id="estadoMoto" class="mb-1">Motos: </p>
                        <p id="estadoEspecial">Especiales: </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (isGuard)
{
    <script>
        // Mensaje inicial si es guardia
        alert("Bienvenido Guarda, Selecciona el parqueo asignado antes de registrar un ingreso");
    </script>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function getSelectedParkingLot() {
            return $('#parkingLotSelect').val();
        }

        function actualizarSemaforo() {
            const placa = $('#placa').val().trim();
            const parkingLotId = getSelectedParkingLot();

            if (!placa) {
                $('#semaforo').css('background-color', 'gray');
                $('#mensajeSemaforo').text('');
                return;
            }

            // Verifica si el vehículo puede ingresar
            $.post('/Access/VerificarIngresoSemaforo', { placa, parkingLotId }, function (data) {
                if (data.needsModal) {
                    $('#semaforo').css('background-color', 'yellow');
                    $('#mensajeSemaforo').text('Vehículo no registrado - requiere datos');
                } else {
                    $('#semaforo').css('background-color', data.success ? 'green' : 'red');
                    $('#mensajeSemaforo').text(data.message);
                }
            });
        }

        // Actualiza el estado de ocupación del parqueo
        function actualizarEstado() {
            const parkingLotId = getSelectedParkingLot();

            $.post('/Access/ObtenerEstadoParqueo', { parkingLotId }, function (data) {
                if (data.success) {
                    $('#estadoRegular').text("Vehículos: " + data.regular);
                    $('#estadoMoto').text("Motos: " + data.moto);
                    $('#estadoEspecial').text("Especiales: " + data.especial);
                }
            });
        }


        // Registrar ingreso
        function registrarIngreso() {
            const placa = $('#placa').val().trim();
            const parkingLotId = getSelectedParkingLot();

            if (!placa) {
                alert('Ingrese una placa.');
                return;
            }

            // Primero verifica si puede ingresar
            $.post('/Access/VerificarIngresoSemaforo', { placa, parkingLotId }, function (data) {
                if (data.needsModal) {
                    // Mostrar modal para vehículo no registrado
                    mostrarModalTemporalTEST(placa, parkingLotId);
                } else if (data.success) {
                    // Vehículo registrado normal - proceder directamente
                    $.post('/Access/RegistrarIngreso', { placa, parkingLotId }, function (resp) {
                        mostrarMensaje(resp.message, resp.success ? 'success' : 'danger');
                        actualizarEstado();
                        actualizarSemaforo();
                    });
                    // Error - mostrar mensaje
                    mostrarMensaje(data.message, 'danger');
                    $('#semaforo').css('background-color', 'red');
                    $('#mensajeSemaforo').text(data.message);
                }
            });
        }

        // Modal para vehículos temporales mejorado
        function mostrarModalTemporalTEST(placa, parkingLotId) {
            Swal.fire({
                title: 'Vehículo No Registrado',
                html: `
                        <p style="margin-bottom: 15px;">La placa <strong>${placa}</strong> no está registrada en el sistema.</p>
                        <p style="margin-bottom: 20px; color: #d9534f;">⚠️ <strong>Nota:</strong> Los vehículos temporales solo pueden usarse UNA VEZ.</p>

                        <div style="text-align: left;">
                            <label style="display: block; margin-bottom: 5px; font-weight: bold;">Tipo de vehículo:</label>
                            <select id="tempTipo" class="swal2-input" style="margin-bottom: 15px;">
                                <option value="">Seleccione tipo</option>
                                <option value="Carro">Carro</option>
                                <option value="Moto">Moto</option>
                            </select>

                            <label style="display: block; margin-bottom: 10px;">
                                <input type="checkbox" id="tempLey7600" style="margin-right: 5px;">
                                <strong>Aplica Ley 7600 (Espacio especial)</strong>
                            </label>

                            <div style="background-color: #f8f9fa; padding: 10px; border-radius: 5px; margin-top: 10px;">
                                <small style="color: #6c757d;">
                                    <strong>Recordatorio:</strong> Si este vehículo visitará regularmente,
                                    considere registrarlo como vehículo permanente.
                                </small>
                            </div>
                        </div>
                    `,
                width: '500px',
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: "Registrar Acceso Temporal",
                cancelButtonText: "Cancelar",
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                preConfirm: () => {
                    const tipo = $('#tempTipo').val();
                    const ley7600 = $('#tempLey7600').is(':checked');

                    if (!tipo) {
                        Swal.showValidationMessage('Debe seleccionar el tipo de vehículo');
                        return false;
                    }
                    return { tipo, ley7600 };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Access/RegistrarIngreso', {
                        placa: placa,
                        parkingLotId: parkingLotId,
                        vehicleType: result.value.tipo,
                        usesSpecialSpace: result.value.ley7600
                    }, function (resp) {
                        mostrarMensaje(resp.message, resp.success ? 'success' : 'danger');
                        actualizarEstado();
                        actualizarSemaforo();
                    });
                }
            });
        }

        // Función para mostrar mensajes
        function mostrarMensaje(mensaje, tipo) {
            $('#mensaje').html(`<span>${mensaje}</span>`)
                .removeClass()
                .addClass(`alert alert-${tipo}`)
                .show();

            // Ocultar mensaje después de 5 segundos
            setTimeout(() => {
                $('#mensaje').fadeOut();
            }, 5000);
        }

        // Registrar salida
        function registrarSalida() {
            const placa = $('#placa').val().trim();
            const parkingLotId = getSelectedParkingLot();

            if (!placa) {
                alert('Ingrese una placa.');
                return;
            }

            $.post('/Access/RegistrarSalida', { placa, parkingLotId }, function (data) {
                mostrarMensaje(data.message, data.success ? 'primary' : 'danger');
                actualizarEstado();
                actualizarSemaforo();
            });
        }

        $('#placa').on('input', actualizarSemaforo);
        $('#parkingLotSelect').change(function () {
            actualizarEstado();
            actualizarSemaforo();
        });

        // Inicializar al cargar la página
        $(document).ready(function () {
            actualizarEstado();
            actualizarSemaforo();
        });
    </script>
}