@model List<Ulacit_parking.Models.ViewModels.MovementLogsViewModel>

@{
    ViewBag.Title = "Bitácora de Movimientos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-3">
        <h2 class="m-0">Entradas y salidas</h2>
        <select id="filtroTipoVehiculo" class="form-select w-auto" onchange="filtrarPorTipo()">
            <option value="todos" selected>Todos los vehículos</option>
            <option value="registrados">Vehículos registrados</option>
            <option value="temporales">Vehículos temporales</option>
        </select>
    </div>

    <div class="mb-3">
        <input type="text" class="form-control" placeholder="Buscar por placa, marca o parqueo..." id="filtroInput" onkeyup="filtrarMovimientos(this.value)" />
    </div>

    <div class="table-responsive d-none d-md-block">
        <table class="table table-bordered table-hover" id="movimientosTable">
            <thead class="table-dark">
                <tr>
                    <th>Marca</th>
                    <th>Placa</th>
                    <th>Parqueo</th>
                    <th>Tipo</th>
                    <th>Vehículo Temporal</th>
                    <th>Fecha y hora</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    var registrado = m.Vehicle != null;
                    var temporal = m.TemporaryVehicle != null;

                    <tr class="movimiento-row"
                        data-registrado="@registrado.ToString().ToLower()"
                        data-temporal="@temporal.ToString().ToLower()">
                        <td>@(registrado ? m.Vehicle.Brand : "N/A")</td>
                        <td>@(registrado ? m.Vehicle.LicensePlate : (temporal ? m.TemporaryVehicle.LicensePlate : "N/D"))</td>
                        <td>@(m.ParkingLot != null ? m.ParkingLot.Name : "N/D")</td>
                        <td>
                            <span class="badge @(m.EntryExit == "E" ? "bg-success" : "bg-danger")">
                                @(m.EntryExit == "E" ? "Entrada" : "Salida")
                            </span>
                        </td>
                        <td>@(temporal ? "Pase temporal" : "N/A")</td>
                        <td>@m.Timestamp.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-md-none" id="movimientosCards">
        @foreach (var m in Model)
        {
            var registrado = m.Vehicle != null;
            var temporal = m.TemporaryVehicle != null;

            <div class="card mb-3 movimiento-card"
                 data-registrado="@registrado.ToString().ToLower()"
                 data-temporal="@temporal.ToString().ToLower()">
                <div class="card-body">
                    <h5 class="card-title"><strong>Marca:</strong> @(registrado ? m.Vehicle.Brand : "N/A")</h5>
                    <p class="card-text mb-1"><strong>Placa:</strong> @(registrado ? m.Vehicle.LicensePlate : (temporal ? m.TemporaryVehicle.LicensePlate : "N/D"))</p>
                    <p class="card-text mb-1"><strong>Parqueo:</strong> @(m.ParkingLot != null ? m.ParkingLot.Name : "N/D")</p>
                    <p class="card-text mb-1">
                        <strong>Tipo:</strong>
                        <span class="badge @(m.EntryExit == "E" ? "bg-success" : "bg-danger")">
                            @(m.EntryExit == "E" ? "Entrada" : "Salida")
                        </span>
                    </p>
                    <p class="card-text mb-1"><strong>Vehículo Temporal:</strong> @(temporal ? "Pase temporal" : "N/A")</p>
                    <p class="card-text mb-0"><strong>Fecha:</strong> @m.Timestamp.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function filtrarMovimientos(text) {
            text = text.toLowerCase();
            var tipo = document.getElementById("filtroTipoVehiculo").value;

            var rows = document.querySelectorAll("#movimientosTable tbody tr");
            for (var i = 0; i < rows.length; i++) {
                var row = rows[i];
                var mostrar = row.textContent.toLowerCase().indexOf(text) > -1 && filtrarPorTipoRow(row, tipo);
                row.style.display = mostrar ? "" : "none";
            }

            var cards = document.querySelectorAll("#movimientosCards .movimiento-card");
            for (var j = 0; j < cards.length; j++) {
                var card = cards[j];
                var mostrar = card.textContent.toLowerCase().indexOf(text) > -1 && filtrarPorTipoRow(card, tipo);
                card.style.display = mostrar ? "" : "none";
            }
        }

        function filtrarPorTipo() {
            filtrarMovimientos(document.getElementById("filtroInput").value);
        }

        function filtrarPorTipoRow(element, tipo) {
            var registrado = element.getAttribute("data-registrado") === "true";
            var temporal = element.getAttribute("data-temporal") === "true";

            if (tipo === "todos") return true;
            if (tipo === "registrados") return registrado;
            if (tipo === "temporales") return temporal;
            return true;
        }
    </script>
}
